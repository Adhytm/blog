---
import Layout from "../layouts/Layout.astro";
import { getAllProjects } from "../lib/projects";
import { Tag } from "../components/tag";

const projects = getAllProjects();

const statusStyle: Record<string, string> = {
  进行中: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
  已完成: "bg-accent/10 text-accent",
  搁置: "bg-zinc-500/10 text-zinc-500 dark:text-zinc-400",
};
---

<Layout title="项目" description="做过和正在做的东西">
  <div class="mx-auto max-w-2xl px-6 pt-20 pb-24 sm:pt-28">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
      项目
    </h1>
    <p class="mt-2 text-sm text-muted">
      做过和正在做的东西。想聊细节的就写篇文章，这里只放个索引。
    </p>

    <div class="mt-12 space-y-6">
      {projects.map((project) => (
        <div
          class="rounded-lg border border-border/50 bg-surface/50 p-5 transition-colors hover:border-border"
        >
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-[15px] font-medium">{project.name}</h2>
            <span
              class={`shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-medium ${
                statusStyle[project.status] ?? ""
              }`}
            >
              {project.status}
            </span>
          </div>

          <p class="mt-2 text-sm leading-relaxed text-muted">
            {project.description}
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-2">
            {project.tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto text-xs text-accent transition-colors hover:opacity-70"
              >
                查看 →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
