---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - 页面不存在">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-32 text-center">
    <p class="text-6xl font-semibold tracking-tight text-muted">404</p>
    <h1 class="mt-4 text-xl font-semibold">页面不存在</h1>
    <p class="mt-2 text-sm text-muted">
      你访问的页面可能已被移动或删除。
    </p>
    <a
      href="/"
      class="mt-8 rounded-full bg-foreground px-5 py-2 text-sm font-medium text-background transition-opacity hover:opacity-80"
    >
      回到首页
    </a>
  </div>
</Layout>
