---
import Layout from "../layouts/Layout.astro";
import { Tag } from "../components/tag";

const techStack = [
  { category: "语言", items: ["TypeScript", "Python（入门）"] },
  { category: "部署 / 基础设施", items: ["Docker", "vLLM", "Qdrant", "Cloudflare"] },
  { category: "系统", items: ["Arch Linux", "Debian"] },
  { category: "折腾过的", items: ["LibreChat", "LobeChat", "new-API", "SQLite"] },
];

/* 折腾时间线：状态用 mono 标注，进行中的条目用 amber 圆点 */
const timeline = [
  { status: "now", label: "正在写", text: "网络监测 TUI——脑子一热立的项，以年为单位写完也没关系" },
  { status: "next", label: "接下来", text: "学 RAG 的 chunk 切分" },
  { status: "done", label: "之前", text: "搭了这个博客：Astro + React 静态导出，部署在 Cloudflare Pages" },
  { status: "done", label: "更早", text: "混合显卡环境部署 vLLM、给 LibreChat 的 Docker 排雷、装 Arch 调驱动" },
];
---

<Layout title="关于" description="关于我 — 开发者、写作者">
  <div class="mx-auto max-w-2xl px-6 pt-20 pb-24 sm:pt-28">
    <!-- 介绍 -->
    <section>
      <div class="flex items-center gap-5">
        <div
          aria-hidden="true"
          class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-accent/25 bg-accent/[0.06] font-mono text-xl font-semibold text-accent"
        >
          {">_"}
        </div>
        <div>
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
            关于我
          </h1>
          <p class="mt-1.5 font-mono text-xs text-muted">
            <span class="text-accent">{"//"}</span> Adhytm · 折腾部署、写小工具、到处挖井
          </p>
        </div>
      </div>
      <div class="mt-8 space-y-4 text-base leading-relaxed text-muted">
        <p>
          一个喜欢折腾部署、写点小工具、到处挖井的人。
          装过 Arch，调过显卡驱动，给 LibreChat 的 Docker 排过雷，
          被 LobeChat 没有 provider 恶心过。
        </p>
        <p>
          这个博客记录折腾过程中的笔记。不追求日更，但希望每篇都有点用。
        </p>
      </div>
    </section>

    <!-- 折腾时间线 -->
    <section class="mt-16">
      <h2 class="section-label">Now</h2>
      <ol class="mt-6 space-y-6 border-l border-border pl-6">
        {timeline.map(({ status, label, text }) => (
          <li class="relative">
            <span
              aria-hidden="true"
              class={`absolute -left-[1.85rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-background ${
                status === "now" ? "bg-accent" : "bg-border"
              }`}
            ></span>
            <p class="font-mono text-xs text-muted">
              <span class={status === "now" ? "text-accent" : ""}>
                {label}
              </span>
            </p>
            <p class="mt-1 text-sm leading-relaxed text-foreground">
              {text}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 技术栈 -->
    <section class="mt-16">
      <h2 class="section-label">Tech Stack</h2>
      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {techStack.map(({ category, items }) => (
          <div>
            <h3 class="text-sm font-medium text-foreground">
              {category}
            </h3>
            <div class="mt-2.5 flex flex-wrap gap-1.5">
              {items.map((item) => (
                <Tag>{item}</Tag>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 联系方式 -->
    <section class="mt-16">
      <h2 class="section-label">Contact</h2>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://github.com/Adhytm"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-surface px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent/30 hover:bg-accent/10 hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          GitHub
        </a>

        <a
          href="mailto:3392027650@qq.com"
          class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-surface px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent/30 hover:bg-accent/10 hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          邮箱
        </a>

        <a
          href="https://space.bilibili.com/334029625"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-surface px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent/30 hover:bg-accent/10 hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="20" height="15" x="2" y="7" rx="2"></rect>
            <path d="m17 2-3 5M7 2l3 5M9 12v4M15 12v4"></path>
          </svg>
          Bilibili
        </a>
      </div>
    </section>
  </div>
</Layout>
