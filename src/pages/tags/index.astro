---
import Layout from "../../layouts/Layout.astro";
import { getTagCounts } from "../../lib/posts";
import { url } from "../../lib/url";

const tags = getTagCounts();
---

<Layout title="标签" description="按主题浏览全部文章标签">
  <div class="mx-auto max-w-2xl px-6 pt-20 pb-24 sm:pt-28">
    <div class="mb-10">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        标签
      </h1>
      <p class="mt-2 section-label">{tags.length} tags</p>
    </div>

    {tags.length > 0 ? (
      <div class="flex flex-wrap gap-2.5">
        {tags.map(({ tag, count }) => (
          <a
            href={url(`/tags/${encodeURIComponent(tag)}`)}
            class="group inline-flex items-center gap-2 rounded-full border border-border/60 bg-surface px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent/30 hover:bg-accent/10 hover:text-accent"
          >
            <span>{tag}</span>
            <span class="font-mono text-xs text-muted/50 transition-colors group-hover:text-accent/70">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-muted">还没有标签</p>
    )}
  </div>
</Layout>
