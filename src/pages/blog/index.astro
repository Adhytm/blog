---
import Layout from "../../layouts/Layout.astro";
import { getAllPosts } from "../../lib/posts";
import { PostList } from "../../components/post-list";
import { url } from "../../lib/url";

const posts = getAllPosts();
---

<Layout title="文章" description="所有博客文章">
  <div class="mx-auto max-w-2xl px-6 pt-20 pb-24 sm:pt-28">
    <div class="mb-10">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
        文章
      </h1>
      <div class="mt-2 flex items-center gap-3">
        <p class="section-label">{posts.length} posts</p>
        <span class="h-3 w-px bg-border"></span>
        <a
          href={url("/tags")}
          class="font-mono text-xs text-muted transition-colors hover:text-accent"
        >
          按标签浏览 →
        </a>
      </div>
    </div>

    <PostList client:load posts={posts} />
  </div>
</Layout>
